# VillageTrade — local development only.
# No production credential belongs in this file, ever.

# Supabase (Phase 2B — not required for Phase 2A local preview)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Feature flags. Absent or anything but the string "true" means OFF.
# Every one of these is off by default and stays off until the founder says
# otherwise. See lib/flags.ts.
FEATURE_VT_AUTH=
FEATURE_VT_LISTINGS=
FEATURE_VT_MESSAGING=
FEATURE_VT_BOOKINGS=
FEATURE_VT_HOLIDAY=
FEATURE_VT_BLESS_A_NEIGHBOR=
FEATURE_VT_LIVE_BOOKINGS=

# Demo mode. Serves clearly-labelled fictional data and no real service.
# This is what Phase 2A runs on.
NEXT_PUBLIC_VT_DEMO=true
