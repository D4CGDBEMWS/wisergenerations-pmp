# =============================================================================
# Wiser Generations Int'l™ — Environment variables
# =============================================================================
# Copy this file to `.env.local` for local development, and mirror every
# variable in Vercel → Project Settings → Environment Variables for
# Production, Preview, and Development.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser and bundled
# into client JavaScript. Everything else is server-only.
# =============================================================================


# -----------------------------------------------------------------------------
# Anthropic — powers the Wiser Generations Virtual Guide (AI chat assistant)
# -----------------------------------------------------------------------------
# Get a key from https://platform.claude.com -> API Keys
#
# SERVER-ONLY. Never prefix this with NEXT_PUBLIC_ and never paste it into any
# file under app/ or components/ that runs in the browser. It is read only by
# app/api/chat/route.ts, which runs on the server.
#
# Set it in Vercel -> Project Settings -> Environment Variables for Production,
# Preview, and Development.

ANTHROPIC_API_KEY=sk-ant-replace_me

# Optional. Which Claude model answers visitor questions.
# Leave unset to use the default (claude-haiku-4-5) — fastest and lowest cost,
# and the right fit for grounded FAQ + lead qualification.
# Set to claude-sonnet-5 to upgrade quality at roughly 3x the cost.
# ANTHROPIC_MODEL=claude-haiku-4-5


# -----------------------------------------------------------------------------
# Stripe — payments and subscriptions
# -----------------------------------------------------------------------------
# Get these from https://dashboard.stripe.com/apikeys
#   • Use sk_test_… / pk_test_… in Preview & Development
#   • Use sk_live_… / pk_live_… in Production
# Test-mode keys cannot read live-mode prices and vice versa — keep them
# consistent within each Vercel environment.

STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Stripe webhook signing secret for /api/stripe/webhook
# Create a webhook endpoint at https://dashboard.stripe.com/webhooks
# pointed at https://wisergenerations.com/api/stripe/webhook and copy
# the "Signing secret" (starts with whsec_…)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Recurring Price ID for the $49/month "Wiser Generations Int'l™ Study Access"
# (the Community of Practice product). Find it under
# Stripe Dashboard → Products → Community of Practice → Pricing.
# Must match the mode (test vs. live) of the keys above.
NEXT_PUBLIC_STRIPE_STUDY_PRICE_ID=price_replace_me


# -----------------------------------------------------------------------------
# Mailchimp — newsletter & enrollment list
# -----------------------------------------------------------------------------
# Used by /api/subscribe (newsletter signup, also tagged for segmentation)
# and the Stripe webhook to add purchasers to Mailchimp.
# API key format: <key>-<datacenter>, e.g. abc123-us21
MAILCHIMP_API_KEY=replace_me-us21
MAILCHIMP_AUDIENCE_ID=replace_me

# Datacenter prefix, e.g. "us21". /api/subscribe requires this explicitly and
# silently skips the subscription when it is missing — if newsletter signups
# are not arriving in Mailchimp, this is the first thing to check.
# (The AI Guide's lead capture derives it from the API key suffix instead, so
# it keeps working either way.)
MAILCHIMP_DC=us21


# -----------------------------------------------------------------------------
# ConvertKit — Free Guide lead magnet
# -----------------------------------------------------------------------------
# Used by /api/free-guide to deliver the "PMP® Exam Changes 2026" PDF.
# https://app.convertkit.com/account_settings/advanced_settings
CONVERTKIT_API_KEY=replace_me
CONVERT_KIT_FORM_ID=replace_me


# -----------------------------------------------------------------------------
# Cloudflare Turnstile — CAPTCHA protection for forms
# -----------------------------------------------------------------------------
# Create a widget at https://dash.cloudflare.com/ -> Turnstile
# Choose "Managed" challenge type for the best user experience.
# Add your production domain (wisergenerations.com) to allowed hostnames.
#
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to expose to the browser (client-side).
# TURNSTILE_SECRET_KEY must stay server-side only — never prefix with NEXT_PUBLIC_.

NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me
TURNSTILE_SECRET_KEY=replace_me
