# =============================================================================
# Wiser Generations Int'l™ — Environment variables
# =============================================================================
# Copy this file to `.env.local` for local development, and mirror every
# variable in Vercel → Project Settings → Environment Variables for
# Production, Preview, and Development.
#
# Variables prefixed with NEXT_PUBLIC_ are exposed to the browser and bundled
# into client JavaScript. Everything else is server-only.
# =============================================================================


# -----------------------------------------------------------------------------
# Stripe — payments and subscriptions
# -----------------------------------------------------------------------------
# Get these from https://dashboard.stripe.com/apikeys
#   • Use sk_test_… / pk_test_… in Preview & Development
#   • Use sk_live_… / pk_live_… in Production
# Test-mode keys cannot read live-mode prices and vice versa — keep them
# consistent within each Vercel environment.

STRIPE_SECRET_KEY=sk_test_replace_me
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_replace_me

# Stripe webhook signing secret for /api/stripe/webhook
# Create a webhook endpoint at https://dashboard.stripe.com/webhooks
# pointed at https://wisergenerations.com/api/stripe/webhook and copy
# the "Signing secret" (starts with whsec_…)
STRIPE_WEBHOOK_SECRET=whsec_replace_me

# Recurring Price ID for the $49/month "Wiser Generations Int'l™ Study Access"
# (the Community of Practice product). Find it under
# Stripe Dashboard → Products → Community of Practice → Pricing.
# Must match the mode (test vs. live) of the keys above.
NEXT_PUBLIC_STRIPE_STUDY_PRICE_ID=price_replace_me


# -----------------------------------------------------------------------------
# Mailchimp — newsletter & enrollment list
# -----------------------------------------------------------------------------
# Used by /api/subscribe (newsletter signup, also tagged for segmentation)
# and the Stripe webhook to add purchasers to Mailchimp.
# API key format: <key>-<datacenter>, e.g. abc123-us21
MAILCHIMP_API_KEY=replace_me-us21
MAILCHIMP_AUDIENCE_ID=replace_me


# -----------------------------------------------------------------------------
# ConvertKit — Free Guide lead magnet
# -----------------------------------------------------------------------------
# Used by /api/free-guide to deliver the "PMP® Exam Changes 2026" PDF.
# https://app.convertkit.com/account_settings/advanced_settings
# ConvertKit powers the free-guide delivery sequence. BOTH are required — with
# either one missing the route accepts the submission, tells the visitor their
# guide is on its way, and discards the address.
#
# The form id is read as CONVERT_KIT_FORM_ID or CONVERTKIT_FORM_ID, because the
# original pair spelled the product name two different ways and setting them
# consistently left the form id unread.
CONVERTKIT_API_KEY=replace_me
CONVERT_KIT_FORM_ID=replace_me
CONVERT_KIT_FORM_ID=replace_me


# -----------------------------------------------------------------------------
# Cloudflare Turnstile — CAPTCHA protection for forms
# -----------------------------------------------------------------------------
# Create a widget at https://dash.cloudflare.com/ -> Turnstile
# Choose "Managed" challenge type for the best user experience.
# Add your production domain (wisergenerations.com) to allowed hostnames.
#
# NEXT_PUBLIC_TURNSTILE_SITE_KEY is safe to expose to the browser (client-side).
# TURNSTILE_SECRET_KEY must stay server-side only — never prefix with NEXT_PUBLIC_.

NEXT_PUBLIC_TURNSTILE_SITE_KEY=replace_me
TURNSTILE_SECRET_KEY=replace_me

# =============================================================================
# Phase 0.5 — Secure Foundation
# =============================================================================

# Neon PostgreSQL connection string. REQUIRED: authorization reads the database
# and deliberately does not fall back to a weaker check if it is missing — a
# missing database fails closed rather than granting access.
# Neon dashboard → your project → Connection Details → pooled connection string.
DATABASE_URL=postgresql://user:password@ep-xxxx.region.aws.neon.tech/dbname?sslmode=require

# Salt for one-way hashing of IP addresses in audit rows. Any long random
# string. Changing it invalidates nothing; it only re-salts future hashes.
SESSION_SECRET=replace_me_with_32_plus_random_characters

# Magic-link delivery. Set ONE of the two keys below; RESEND_API_KEY wins if
# both are present.
#
# Resend is the cheaper path: the contact form already uses it and the free
# tier covers 3,000 emails a month.
#
# Mandrill (Mailchimp Transactional) is a SEPARATE add-on from the Mailchimp
# marketing plan and issues its own key. MAILCHIMP_API_KEY is a marketing key
# and is rejected by Mandrill's API, so it is no longer accepted here — as a
# fallback it could only ever fail silently.
#
# Whichever provider is used, the sending domain must be verified with that
# provider or the mail will be dropped or spam-foldered.
RESEND_API_KEY=
MANDRILL_API_KEY=

# The From address. RESEND_FROM_EMAIL is the shared default used by both the
# contact form and the login email; MAGIC_LINK_FROM_EMAIL overrides it for
# login mail alone. Whichever is used must be on a domain verified with the
# provider above — Resend's onboarding@resend.dev fallback delivers only to the
# Resend account owner, so it is for first-run testing and not for customers.
RESEND_FROM_EMAIL=info@wisergenerations.com
MAGIC_LINK_FROM_EMAIL=

# Feature flags. Off unless the value is exactly "true". Life Is a Project and
# the CAPM 17-24 pathway have no routes yet; these exist so the routes can ship
# disabled when they do.
FEATURE_LIAP=false
FEATURE_CAPM_PATHWAY=false
